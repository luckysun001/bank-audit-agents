# ==========================================
# 银行审计多智能体平台环境变量配置
# ==========================================

# ==============================
# LLM 配置
# ==============================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ==============================
# 智能体配置
# ==============================
AGENT_MAX_ITERATIONS=10
AGENT_PARALLEL_EXECUTION=true
AGENT_ENABLE_MEMORY=true
AGENT_ENABLE_THINKING=true
AGENT_TIMEOUT_SECONDS=300
WORKFLOW_TIMEOUT_SECONDS=1800

# ==============================
# 向量数据库配置
# ==============================
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_COLLECTION=audit_knowledge_base

# ==============================
# Redis 配置（可选）
# ==============================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLE=false
REDIS_CACHE_TTL=3600

# ==============================
# 审计追踪配置
# ==============================
AUDIT_TRAIL_ENABLED=true
AUDIT_TRAIL_PATH=./data/audit_trails
AUDIT_TRAIL_RETENTION_DAYS=90
SAVE_INTERMEDIATE_RESULTS=true

# ==============================
# 报告生成配置
# ==============================
REPORT_OUTPUT_PATH=./data/reports
REPORT_FORMATS=md,docx,pdf
REPORT_TEMPLATE_PATH=./config/templates

# ==============================
# UI 配置
# ==============================
UI_PORT=8501
UI_THEME=light

# ==============================
# API 配置
# ==============================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_CORS_ORIGINS=["http://localhost:8501"]

# ==============================
# 安全配置
# ==============================
API_KEY_ENABLED=true
API_KEYS=["change-me-in-production"]
SENSITIVE_FIELDS=["password","api_key","secret","token","credential","account_number","id_card","phone","email"]

# ==============================
# 日志配置
# ==============================
LOG_LEVEL=INFO
LOG_FILE=./logs/bank_audit_agents.log
LOG_FORMAT=json

# ==============================
# 其他配置
# ==============================
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="银行审计多智能体平台"
